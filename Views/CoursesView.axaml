<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WestCoastEducation.ViewModels"
             xmlns:models="using:WestCoastEducation.Models"
             x:Class="WestCoastEducation.Views.CoursesView"
             x:DataType="vm:CoursesViewModel">

  <Grid ColumnDefinitions="*,16,380">

    <Border Classes="card">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
          <TextBlock Classes="title" Text="Kurser" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Uppdatera" Command="{Binding LoadCommand}" />
        </Grid>
        <TextBlock DockPanel.Dock="Bottom" Classes="muted" Margin="0,12,0,0"
                   Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        <ProgressBar DockPanel.Dock="Bottom" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedRow}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CourseRow">
              <StackPanel Spacing="2" Margin="4">
                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" />
                <TextBlock Classes="muted" Text="{Binding Details}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <Border Grid.Column="2" Classes="card">
      <ScrollViewer>
        <StackPanel Spacing="10">
          <TextBlock Classes="title" Text="{Binding FormTitle}" />

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Kursnummer" />
            <TextBox Text="{Binding CourseNumber}" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Titel" />
            <TextBox Text="{Binding Title}" />
          </StackPanel>

          <Grid ColumnDefinitions="*,12,*">
            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="Startdatum" />
              <CalendarDatePicker SelectedDate="{Binding StartDate}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
              <TextBlock Classes="label" Text="Slutdatum" />
              <CalendarDatePicker SelectedDate="{Binding EndDate}" HorizontalAlignment="Stretch" />
            </StackPanel>
          </Grid>

          <CheckBox IsChecked="{Binding IsDistance}" Content="Distanskurs (annars klassrum)" />

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="{Binding LocationLabel}" />
            <TextBox Text="{Binding Location}" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Lärare" />
            <ComboBox ItemsSource="{Binding Teachers}" SelectedItem="{Binding SelectedTeacher}"
                      HorizontalAlignment="Stretch" PlaceholderText="Välj lärare">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:Teacher">
                  <TextBlock Text="{Binding FullName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <Button Classes="primary" Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}" />
            <Button Content="Rensa" Command="{Binding ClearFormCommand}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEditing}">
            <Button Classes="danger" Content="Radera kurs"
                    IsVisible="{Binding !IsConfirmingDelete}" Command="{Binding RequestDeleteCommand}" />
            <Button Classes="danger" Content="Bekräfta radering"
                    IsVisible="{Binding IsConfirmingDelete}" Command="{Binding ConfirmDeleteCommand}" />
            <Button Content="Avbryt"
                    IsVisible="{Binding IsConfirmingDelete}" Command="{Binding CancelDeleteCommand}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

  </Grid>

</UserControl>
