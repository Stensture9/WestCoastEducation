<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- färger för ljust och mörkt tema, används med DynamicResource -->
  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F5F9" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="AppBorderBrush" Color="#DDE2EB" />
      <SolidColorBrush x:Key="AppTextBrush" Color="#1B2430" />
      <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7686" />
      <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
      <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8" />
      <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
      <SolidColorBrush x:Key="DangerHoverBrush" Color="#B91C1C" />
      <SolidColorBrush x:Key="HeaderBrush" Color="#0F2A4A" />
      <SolidColorBrush x:Key="HeaderTextBrush" Color="#FFFFFF" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F141C" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#18202B" />
      <SolidColorBrush x:Key="AppBorderBrush" Color="#2A3544" />
      <SolidColorBrush x:Key="AppTextBrush" Color="#E6EBF2" />
      <SolidColorBrush x:Key="MutedTextBrush" Color="#93A0B4" />
      <SolidColorBrush x:Key="PrimaryBrush" Color="#3B82F6" />
      <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#60A5FA" />
      <SolidColorBrush x:Key="OnPrimaryBrush" Color="#0B1220" />
      <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
      <SolidColorBrush x:Key="DangerHoverBrush" Color="#F87171" />
      <SolidColorBrush x:Key="HeaderBrush" Color="#0B1220" />
      <SolidColorBrush x:Key="HeaderTextBrush" Color="#E6EBF2" />
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <CornerRadius x:Key="AppCornerRadius">8</CornerRadius>
  <Thickness x:Key="AppCardPadding">16</Thickness>
  <x:Double x:Key="AppFontSize">14</x:Double>
  <x:Double x:Key="AppTitleFontSize">20</x:Double>

</ResourceDictionary>
